# What Perforce leaves out of the full project (P4IGNORE=.p4ignore). Perforce (//depot) holds the whole project:
# code, config, docs, tools, Unreal content and the final art sources. GitHub holds only the text part (see .gitignore).

# Build output, caches and machine-specific files
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/
Plugins/.../Binaries/
Plugins/.../Intermediate/
.git/
.vs/
.idea/
.vsconfig
*.sln
*.slnx
*.suo
*.VC.db
*.VC.opendb
__pycache__/
*.pyc
Tools/Blender/logs/
tmp/
Models and Rigs/
.env
*_BuiltData.uasset

# Blender backups and logs
*.blend1
*.blend@
*.log

# Resources/Models: only the final art sources and the pipeline's start files. Studies, repairs, reviews, archives and
# intermediate builds are regenerated by Tools/ and stay local.
Resources/Previews/
Resources/Models/*/
!Resources/Models/Fitted/
!Resources/Models/MetaHuman/
!Resources/Models/Modular/
!Resources/Models/MotionBuilder/
!Resources/Models/Referee/
!Resources/Models/Textures/
!Resources/Models/Fighter_Rigged.fbm/
!Resources/Models/TestFighter/
!Resources/Models/CharacterSuite/
!Resources/Models/Animation/
!Resources/Models/FinalRefinement/
Resources/Models/MotionBuilder/*.bck/
Resources/Models/MotionBuilder/*.fbm/

# CharacterSuite: each body's Gameplay_High.blend (what every fighter build starts from), its textures and notes; the LOD,
# crowd and FBX outputs are rebuilt by rebuild_updated_characters.py
Resources/Models/CharacterSuite/*/*
!Resources/Models/CharacterSuite/*/Gameplay_High.blend
!Resources/Models/CharacterSuite/Textures/*

# Animation: the placeholder technique clips and the MotionBuilder characters for capture
Resources/Models/Animation/*/
!Resources/Models/Animation/PlaceholderTechniques/
!Resources/Models/Animation/MotionBuilder/

# FinalRefinement: the current fighter chain only (traditional dobok start files, portrait and match fighters)
Resources/Models/FinalRefinement/*
!Resources/Models/FinalRefinement/TraditionalDobok/
!Resources/Models/FinalRefinement/Portrait/
!Resources/Models/FinalRefinement/Match/
Resources/Models/FinalRefinement/TraditionalDobok/*/Candidate.blend
Resources/Models/FinalRefinement/TraditionalDobok/Review/
Resources/Models/FinalRefinement/Portrait/*/Candidate.blend
Resources/Models/FinalRefinement/Match/*/Work.blend
Resources/Models/FinalRefinement/Match/Roster/
